+/// An ISO BMFF file whose `ftyp` box names an AVIF brand, major or compatible.
+fn is_avif(buffer: &[u8]) -> bool {
+    let Some(size) = buffer.get(..4) else {
+        return false;
+    };
+    let size = u32::from_be_bytes([size[0], size[1], size[2], size[3]]) as usize;
+    if buffer.get(4..8) != Some(b"ftyp") {
+        return false;
+    }
+    // Brands are four bytes each: the major brand, a version, then the compatible ones.
+    let end = size.clamp(12, buffer.len().max(12));
+    buffer
+        .get(8..end)
+        .unwrap_or_default()
+        .chunks_exact(4)
+        .enumerate()
+        .any(|(index, brand)| index != 1 && (brand == b"avif" || brand == b"avis"))
+}
