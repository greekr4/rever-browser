+#[cfg(test)]
+mod svg_style_tests {
+    use super::{svg_markup_with_styles, svg_start_tags};
+
+    fn styles(list: &[&str]) -> Vec<String> {
+        list.iter().map(|text| (*text).to_owned()).collect()
+    }
+
+    #[test]
+    fn 스타일은_순서가_같은_요소에_들어간다() {
+        let markup = r#"<svg viewBox="0 0 36 36"><circle class="a"/><path d="M1 1"/></svg>"#;
+        assert_eq!(svg_start_tags(markup).len(), 3);
+        assert_eq!(
+            svg_markup_with_styles(markup, &styles(&["color:red", "fill:rgba(0,0,0,0.35)", ""])),
+            r#"<svg style="color:red" viewBox="0 0 36 36"><circle style="fill:rgba(0,0,0,0.35)" class="a"/><path d="M1 1"/></svg>"#
+        );
+    }
+
+    #[test]
+    fn 이미_있는_style_속성은_남고_우선한다() {
+        let markup = r#"<svg><g style="fill:blue"/></svg>"#;
+        assert_eq!(
+            svg_markup_with_styles(markup, &styles(&["", "fill:red"])),
+            r#"<svg><g style="fill:red;fill:blue"/></svg>"#
+        );
+    }
+
+    #[test]
+    fn use가_끌어온_요소는_스타일_없이_뒤에_남는다() {
+        // 페이지의 다른 곳에서 복사해 온 `<symbol>`이 `<svg>`의 요소들 뒤에 붙는다.
+        let markup = r##"<svg><use href="#dot"/><symbol id="dot"><circle/></symbol></svg>"##;
+        assert_eq!(
+            svg_markup_with_styles(markup, &styles(&["color:red", "fill:blue"])),
+            r##"<svg style="color:red"><use style="fill:blue" href="#dot"/><symbol id="dot"><circle/></symbol></svg>"##
+        );
+    }
+
+    #[test]
+    fn 요소가_스타일보다_적으면_루트에만_넣는다() {
+        let markup = "<svg><g/></svg>";
+        assert_eq!(
+            svg_markup_with_styles(markup, &styles(&["color:red", "fill:red", "fill:blue"])),
+            "<svg style=\"color:red\"><g/></svg>"
+        );
+    }
+
+    #[test]
+    fn 주석과_닫는_태그와_따옴표_안_꺾쇠는_요소가_아니다() {
+        let markup = r#"<svg><!-- <g> --><text x="1>2">a</text><![CDATA[<b>]]></svg>"#;
+        assert_eq!(svg_start_tags(markup).len(), 2);
+    }
