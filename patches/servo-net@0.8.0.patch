diff --color --color=never -ruN -x Cargo.lock -x .cargo-ok -x .cargo_vcs_info.json a/tap.rs b/tap.rs
--- a/tap.rs	1970-01-01 09:00:00
+++ b/tap.rs	2026-11-18 12:53:34
@@ -0,0 +1,89 @@
+/* rever patch (not upstream): hand request and response bodies to the embedder
+ * in-process. The network threads live in the embedder's process, so a
+ * process-wide callback is enough for a proof of concept. */
+
+use std::sync::OnceLock;
+
+use http::{HeaderMap, Method};
+use servo_url::ServoUrl;
+
+/// `id` is the fetch's request id, shared by a request and its response.
+pub enum NetworkTapEvent {
+    Request {
+        id: String,
+        url: ServoUrl,
+        method: Method,
+        headers: HeaderMap,
+        body: Vec<u8>,
+        /// Debug name of the fetch destination ("Document", "Script", "None" for XHR/fetch, ...).
+        destination: String,
+        /// The initiating WebView (tab) as a u64 (namespace<<32 | index), so the
+        /// embedder can stamp the request with the tab it belongs to. None for
+        /// requests with no target webview.
+        webview_id: Option<u64>,
+    },
+    Response { id: String, url: ServoUrl, status: u16, headers: HeaderMap, body: Vec<u8> },
+}
+
+type Tap = Box<dyn Fn(NetworkTapEvent) + Send + Sync>;
+static TAP: OnceLock<Tap> = OnceLock::new();
+
+/// Install the callback once, before the first page load. It runs on network threads.
+pub fn set_network_tap(tap: impl Fn(NetworkTapEvent) + Send + Sync + 'static) {
+    let _ = TAP.set(Box::new(tap));
+}
+
+pub(crate) fn active() -> bool {
+    TAP.get().is_some()
+}
+
+pub(crate) fn emit(event: NetworkTapEvent) {
+    if let Some(tap) = TAP.get() {
+        tap(event);
+    }
+}
+
+/// What the embedder may change on the way: all three run on network threads.
+pub struct NetworkEditors {
+    /// Before a request is sent: may change its headers.
+    pub request: Box<dyn Fn(&ServoUrl, &Method, &mut HeaderMap) + Send + Sync>,
+    /// When the headers of a response arrive: may change them. True keeps the
+    /// body back until it is complete and hands it to `response_body`.
+    pub response_headers: Box<dyn Fn(&ServoUrl, &mut HeaderMap) -> bool + Send + Sync>,
+    /// The whole body of a response that was kept back: returns the body to deliver.
+    /// It may wait for a decision; the task that delivers this one response waits with it.
+    pub response_body:
+        Box<dyn Fn(&ServoUrl, &Method, u16, &HeaderMap, Vec<u8>) -> Vec<u8> + Send + Sync>,
+}
+
+static EDITORS: OnceLock<NetworkEditors> = OnceLock::new();
+
+/// Install the editors once, before the first page load.
+pub fn set_network_editors(editors: NetworkEditors) {
+    let _ = EDITORS.set(editors);
+}
+
+pub(crate) fn edit_request(url: &ServoUrl, method: &Method, headers: &mut HeaderMap) {
+    if let Some(editors) = EDITORS.get() {
+        (editors.request)(url, method, headers);
+    }
+}
+
+pub(crate) fn response_headers(url: &ServoUrl, headers: &mut HeaderMap) -> bool {
+    EDITORS
+        .get()
+        .is_some_and(|editors| (editors.response_headers)(url, headers))
+}
+
+pub(crate) fn response_body(
+    url: &ServoUrl,
+    method: &Method,
+    status: u16,
+    headers: &HeaderMap,
+    body: Vec<u8>,
+) -> Vec<u8> {
+    match EDITORS.get() {
+        Some(editors) => (editors.response_body)(url, method, status, headers, body),
+        None => body,
+    }
+}
