+    /// rever: stop `img` waiting; true when it was.
+    pub(crate) fn unregister_lazy_image(&self, img: &HTMLImageElement) -> bool {
+        let mut images = self.lazy_images.borrow_mut();
+        let before = images.len();
+        images.retain(|image| **image != *img);
+        images.len() != before
+    }
