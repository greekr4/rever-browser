+    /// rever: have `img` wait for [`Document::load_lazy_images_near_viewport`].
+    pub(crate) fn register_lazy_image(&self, img: &HTMLImageElement) {
+        let mut images = self.lazy_images.borrow_mut();
+        if !images.iter().any(|image| **image == *img) {
+            images.push(Dom::from_ref(img));
+        }
