+    /// rever: start the lazy images that are within a screen or so of the viewport
+    /// (the distance Chrome uses on a fast connection). Run at every rendering
+    /// update, which a scroll and a layout change both cause.
+    // shortcut: an image taken out of the document keeps waiting here until the
+    // document goes; drop it on unbind if pages that churn lazy images grow.
+    pub(crate) fn load_lazy_images_near_viewport(&self, cx: &mut JSContext) {
+        let waiting: Vec<DomRoot<HTMLImageElement>> = std::mem::take(
+            &mut *self.lazy_images.borrow_mut(),
+        )
+        .iter()
+        .map(|image| DomRoot::from_ref(&**image))
+        .collect();
+        if waiting.is_empty() {
+            return;
+        }
+        let viewport = self.window().viewport_details().size;
+        let margin = app_units::Au::from_px(1250);
+        let (width, height) = (
+            app_units::Au::from_f32_px(viewport.width),
+            app_units::Au::from_f32_px(viewport.height),
+        );
+        for image in waiting {
+            let node = image.upcast::<Node>();
+            // An image without a box (`display: none`, not in the document) is not near.
+            let near = node.is_connected() &&
+                node.border_box(cx).is_some_and(|rect| {
+                    rect.max_y() > -margin &&
+                        rect.min_y() < height + margin &&
+                        rect.max_x() > -margin &&
+                        rect.min_x() < width + margin
+                });
+            if near {
+                image.resume_lazy_load(cx);
+            } else {
+                self.register_lazy_image(&image);
+            }
+        }
+    }
