diff --color -ruN -x Cargo.lock -x .cargo-ok a/tap.rs b/tap.rs
--- a/tap.rs	1970-01-01 09:00:00
+++ b/tap.rs	2026-11-12 16:14:22
@@ -0,0 +1,31 @@
+/* rever patch (not upstream): hand request and response bodies to the embedder
+ * in-process. The network threads live in the embedder's process, so a
+ * process-wide callback is enough for a proof of concept. */
+
+use std::sync::OnceLock;
+
+use http::{HeaderMap, Method};
+use servo_url::ServoUrl;
+
+pub enum NetworkTapEvent {
+    Request { url: ServoUrl, method: Method, headers: HeaderMap, body: Vec<u8> },
+    Response { url: ServoUrl, status: u16, headers: HeaderMap, body: Vec<u8> },
+}
+
+type Tap = Box<dyn Fn(NetworkTapEvent) + Send + Sync>;
+static TAP: OnceLock<Tap> = OnceLock::new();
+
+/// Install the callback once, before the first page load. It runs on network threads.
+pub fn set_network_tap(tap: impl Fn(NetworkTapEvent) + Send + Sync + 'static) {
+    let _ = TAP.set(Box::new(tap));
+}
+
+pub(crate) fn active() -> bool {
+    TAP.get().is_some()
+}
+
+pub(crate) fn emit(event: NetworkTapEvent) {
+    if let Some(tap) = TAP.get() {
+        tap(event);
+    }
+}
